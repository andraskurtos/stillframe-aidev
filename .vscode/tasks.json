{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev-server",
      "type": "npm",
      "script": "dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "x^",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local.*http"
        }
      }
    },
    {
      "label": "build",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "preview-server",
      "type": "npm",
      "script": "preview",
      "isBackground": true,
      "dependsOn": "build",
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "x^",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local.*http"
        }
      }
    }
  ]
}
